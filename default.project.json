{
  "name": "LooksmaxSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "LocalizationService": {
      "Strings": { "$path": "src/localization/Strings.csv" }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": true }
    }
  }
}
